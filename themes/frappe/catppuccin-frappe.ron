#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#303446",
    text_color: "#c6d0f5",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "#e5c890"),
    preview_metadata_group_style: (fg: "#e5c890", modifiers: "Bold"),
    highlighted_item_style: (fg: "#ca9ee6", modifiers: "Bold"),
    current_item_style: (bg: "#51576d", fg: "#ca9ee6", modifiers: "Bold"),
    borders_style: (fg: "#949cbb"),
    highlight_border_style: (fg: "#949cbb"),
    symbols: (
        song: "󰝚",
        dir: "󰀥",
        playlist: "󰲸",
        marker: "󰐃",
        ellipsis: "...",
        song_style: (fg: "#949cbb"),
        dir_style:(fg: "#e5c890"),
    ),
    level_styles: (
        info: (fg: "#ca9ee6", bg: "#303446"),
        warn: (fg: "#e5c890", bg: "#303446"),
        error: (fg: "#e78284", bg: "#303446"),
        debug: (fg: "#a6d189", bg: "#303446"),
        trace: (fg: "#babbf1", bg: "#303446"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#292c3c"),
        elapsed_style: (fg: "#ca9ee6"),
        thumb_style: (fg: "#ca9ee6"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        thumb_style: (fg: "#ca9ee6"),
    ),
    tab_bar: (
        active_style: (fg: "#303446", bg: "#ca9ee6", modifiers: "Bold"),
	inactive_style: (fg: "#c6d0f5", bg: "#303446")
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown")),
		style: (fg: "#ef9f76"),
		align: right
            ),
            width: "20%",
        ),
	(
	    prop: (kind: Text(" - "),
	    style: (fg: "#c6d0f5")
	    ),
            width: "3",
	),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown")),
		style: (fg: "#e5c890"),
            ),
            width: "65%",
        ),
        (
            prop: (kind: Property(Duration),
	    	style: (fg: "#c6d0f5"),
                default: (kind: Text("-"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [

	    (pane: Split(
		direction: Horizontal,
		panes: [
			(
			pane: Pane(Tabs),
			align: Center,
			borders: "ALL",
                        border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
			size: "100%"

			),

			(
			    size: "20",
			    borders: "RIGHT | TOP | BOTTOM",
			    border_symbols: Rounded,
			    pane: Pane(Property(content: [
				(kind: Text("("), style: (fg: "#c6d0f5", modifiers: "Bold")),
				(kind: Property(Status(RepeatV2(
				    on_label: "",
				    off_label: "",
				    on_style: (fg: "#a6d189", modifiers: "Bold"),
				    off_style: (fg: "#626880", modifiers: "Bold"),
				)))),
				(kind: Text(" | "), style: (fg: "#c6d0f5", modifiers: "Bold")),
				(kind: Property(Status(RandomV2(
				    on_label: "",
				    off_label: "",
				    on_style: (fg: "#f4b8e4", modifiers: "Bold"),
				    off_style: (fg: "#626880", modifiers: "Bold"),
				)))),
				(kind: Text(" | "), style: (fg: "#c6d0f5", modifiers: "Bold")),
				(kind: Property(Status(ConsumeV2(
				    on_label: "󰮯",
				    off_label: "󰮯",
				    oneshot_label: "󰮯 󰇊",
				    on_style: (fg: "#e5c890", modifiers: "Bold"),
				    off_style: (fg: "#626880", modifiers: "Bold"),
				    oneshot_style: (fg: "#8caaee", modifiers: "Bold"),
				)))),
				(kind: Text(" | "), style: (fg: "#c6d0f5", modifiers: "Bold")),
				(kind: Property(Status(SingleV2(
				    on_label: "󰎤 ",
				    off_label: "󰎦 ",
				    oneshot_label: "󰇊 ",
				    on_style: (fg: "#babbf1", modifiers: "Bold"),
				    off_style: (fg: "#626880", modifiers: "Bold"),
				    oneshot_style: (fg: "#e5c890", modifiers: "Bold"),
				)))),
				(kind: Text(")"), style: (fg: "#c6d0f5", modifiers: "Bold")),
				],
				align: Center
			    ))
                ),
		]
	    ), size: "3"),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
	    (pane: Component("volume"), size: "1"),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength())), style: (fg: "#c6d0f5")), (kind: Text(" songs / "), style: (fg: "#c6d0f5")), (kind: Property(Status(QueueTimeTotal())), style: (fg: "#c6d0f5")), (kind: Text(" total time "), style: (fg: "#c6d0f5"))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
	"album": Pane(Property(
	content: [
		(kind: Property(Song(Album)), style: (fg: "#c6d0f5", modifiers: "Bold"),
		default: (kind: Text("Unknown"), style: (fg: "#c6d0f5", modifiers: "Bold"))),
	], align: Center
	)),
	"elapsed": Pane(Property(
	content: [
		(kind: Text("("), style: (fg : "#c6d0f5", modifiers: "Bold") ),
		(kind: Property(Status(Elapsed)), style: (fg: "#c6d0f5", modifiers: "Bold")),
		(kind: Text(" / "), style: (fg : "#c6d0f5", modifiers: "Bold") ),
		(kind: Property(Status(Duration)), style: (fg: "#c6d0f5", modifiers: "Bold")),
		(kind: Text(")"), style: (fg : "#c6d0f5", modifiers: "Bold") ),
	], align: Center
	)),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#c6d0f5", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#c6d0f5", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"), track_style: (fg: "#626880"), filled_style: (fg: "#ca9ee6"), thumb_style: (fg: "#626880"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#c6d0f5"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#c6d0f5"))]))),
            ]
        ),
        "artist_and_title": Pane(Property(
            content: [
		(kind: Property(Song(Artist)), style: (fg: "#ef9f76", modifiers: "Bold"),
		 default: (kind: Text("Unknown"), style: (fg: "#ef9f76", modifiers: "Bold"))
		),
		(kind: Text(" - "), style: (fg : "#c6d0f5", modifiers: "Bold") ),
		(kind: Property(Song(Title)), style: (fg: "#e5c890", modifiers: "Bold"),
		default: (kind: Text("Unknown"), style: (fg: "#e5c890", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#303446", bg: "#8caaee", modifiers: "Bold"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#303446", bg: "#a6d189", modifiers: "Bold"))),
                ])))
            ], align: Center
        )),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        ),

	"sidebar": Split(
	    direction: Vertical,
	    panes: [
	        
                (
                    size: "100%",
                    pane: Pane(AlbumArt)
                ),
		(size: "1", pane: Component("album")),
		(size: "1", pane: Component("artist_and_title")),
		(size: "1", pane: Component("elapsed")),
	    ]
	),

	"sidebar_no_lyrics": Split(
	   direction: Vertical,
	   panes: [
	   	(pane: Component("sidebar"), size: "100%"),
		(pane: Pane(Empty()), size: "3")
	   ]
	)

    },

cava: (
    bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
    inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],

    bar_width: 1,
    bar_spacing: 1,
    orientation: Horizontal,
    bar_color: Gradient({

            12: "#81c8be",
            25: "#99d1db",
            36: "#85c1dc",
            50: "#8caaee",
            60: "#ca9ee6",
            75: "#f4b8e4",
            84: "#ea999c",
            100: "#e78284",    
    }),
  ),
)
)
