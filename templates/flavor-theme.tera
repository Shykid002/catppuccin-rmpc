---
whiskers:
  version: ^2.9.0
  matrix:
    - flavor
  filename: "themes/{{flavor.identifier}}/catppuccin-{{ flavor.identifier }}.ron"
---
{%- set palette = flavor.colors -%}
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#{{palette.base.hex}}",
    text_color: "#{{palette.text.hex}}",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "#{{palette.yellow.hex}}"),
    preview_metadata_group_style: (fg: "#{{palette.yellow.hex}}", modifiers: "Bold"),
    highlighted_item_style: (fg: "#{{palette.mauve.hex}}", modifiers: "Bold"),
    current_item_style: (bg: "#{{palette.surface1.hex}}", fg: "#{{palette.mauve.hex}}", modifiers: "Bold"),
    borders_style: (fg: "#{{palette.overlay2.hex}}"),
    highlight_border_style: (fg: "#{{palette.overlay2.hex}}"),
    symbols: (
        song: "󰝚",
        dir: "󰀥",
        playlist: "󰲸",
        marker: "󰐃",
        ellipsis: "...",
        song_style: (fg: "#{{palette.overlay2.hex}}"),
        dir_style:(fg: "#{{palette.yellow.hex}}"),
    ),
    level_styles: (
        info: (fg: "#{{palette.mauve.hex}}", bg: "#{{palette.base.hex}}"),
        warn: (fg: "#{{palette.yellow.hex}}", bg: "#{{palette.base.hex}}"),
        error: (fg: "#{{palette.red.hex}}", bg: "#{{palette.base.hex}}"),
        debug: (fg: "#{{palette.green.hex}}", bg: "#{{palette.base.hex}}"),
        trace: (fg: "#{{palette.lavender.hex}}", bg: "#{{palette.base.hex}}"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#{{palette.mantle.hex}}"),
        elapsed_style: (fg: "#{{palette.mauve.hex}}"),
        thumb_style: (fg: "#{{palette.mauve.hex}}"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        thumb_style: (fg: "#{{palette.mauve.hex}}"),
    ),
    tab_bar: (
        active_style: (fg: "#{{palette.base.hex}}", bg: "#{{palette.mauve.hex}}", modifiers: "Bold"),
	inactive_style: (fg: "#{{palette.text.hex}}", bg: "#{{palette.base.hex}}")
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown")),
		style: (fg: "#{{palette.peach.hex}}"),
		align: right
            ),
            width: "20%",
        ),
	(
	    prop: (kind: Text(" - "),
	    style: (fg: "#{{palette.text.hex}}")
	    ),
            width: "3",
	),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown")),
		style: (fg: "#{{palette.yellow.hex}}"),
            ),
            width: "65%",
        ),
        (
            prop: (kind: Property(Duration),
	    	style: (fg: "#{{palette.text.hex}}"),
                default: (kind: Text("-"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [

	    (pane: Split(
		direction: Horizontal,
		panes: [
			(
			pane: Pane(Tabs),
			align: Center,
			borders: "ALL",
                        border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
			size: "100%"

			),

			(
			    size: "20",
			    borders: "RIGHT | TOP | BOTTOM",
			    border_symbols: Rounded,
			    pane: Pane(Property(content: [
				(kind: Text("("), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
				(kind: Property(Status(RepeatV2(
				    on_label: "",
				    off_label: "",
				    on_style: (fg: "#{{palette.green.hex}}", modifiers: "Bold"),
				    off_style: (fg: "#{{palette.surface2.hex}}", modifiers: "Bold"),
				)))),
				(kind: Text(" | "), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
				(kind: Property(Status(RandomV2(
				    on_label: "",
				    off_label: "",
				    on_style: (fg: "#{{palette.pink.hex}}", modifiers: "Bold"),
				    off_style: (fg: "#{{palette.surface2.hex}}", modifiers: "Bold"),
				)))),
				(kind: Text(" | "), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
				(kind: Property(Status(ConsumeV2(
				    on_label: "󰮯",
				    off_label: "󰮯",
				    oneshot_label: "󰮯 󰇊",
				    on_style: (fg: "#{{palette.yellow.hex}}", modifiers: "Bold"),
				    off_style: (fg: "#{{palette.surface2.hex}}", modifiers: "Bold"),
				    oneshot_style: (fg: "#{{palette.blue.hex}}", modifiers: "Bold"),
				)))),
				(kind: Text(" | "), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
				(kind: Property(Status(SingleV2(
				    on_label: "󰎤 ",
				    off_label: "󰎦 ",
				    oneshot_label: "󰇊 ",
				    on_style: (fg: "#{{palette.lavender.hex}}", modifiers: "Bold"),
				    off_style: (fg: "#{{palette.surface2.hex}}", modifiers: "Bold"),
				    oneshot_style: (fg: "#{{palette.yellow.hex}}", modifiers: "Bold"),
				)))),
				(kind: Text(")"), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
				],
				align: Center
			    ))
                ),
		]
	    ), size: "3"),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
	    (pane: Component("volume"), size: "1"),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength())), style: (fg: "#{{palette.text.hex}}")), (kind: Text(" songs / "), style: (fg: "#{{palette.text.hex}}")), (kind: Property(Status(QueueTimeTotal())), style: (fg: "#{{palette.text.hex}}")), (kind: Text(" total time "), style: (fg: "#{{palette.text.hex}}"))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
	"album": Pane(Property(
	content: [
		(kind: Property(Song(Album)), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold"),
		default: (kind: Text("Unknown"), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold"))),
	], align: Center
	)),
	"elapsed": Pane(Property(
	content: [
		(kind: Text("("), style: (fg : "#{{palette.text.hex}}", modifiers: "Bold") ),
		(kind: Property(Status(Elapsed)), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
		(kind: Text(" / "), style: (fg : "#{{palette.text.hex}}", modifiers: "Bold") ),
		(kind: Property(Status(Duration)), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold")),
		(kind: Text(")"), style: (fg : "#{{palette.text.hex}}", modifiers: "Bold") ),
	], align: Center
	)),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#{{palette.text.hex}}", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"), track_style: (fg: "#{{palette.surface2.hex}}"), filled_style: (fg: "#{{palette.mauve.hex}}"), thumb_style: (fg: "#{{palette.surface2.hex}}"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#{{palette.text.hex}}"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#{{palette.text.hex}}"))]))),
            ]
        ),
        "artist_and_title": Pane(Property(
            content: [
		(kind: Property(Song(Artist)), style: (fg: "#{{palette.peach.hex}}", modifiers: "Bold"),
		 default: (kind: Text("Unknown"), style: (fg: "#{{palette.peach.hex}}", modifiers: "Bold"))
		),
		(kind: Text(" - "), style: (fg : "#{{palette.text.hex}}", modifiers: "Bold") ),
		(kind: Property(Song(Title)), style: (fg: "#{{palette.yellow.hex}}", modifiers: "Bold"),
		default: (kind: Text("Unknown"), style: (fg: "#{{palette.yellow.hex}}", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#{{palette.base.hex}}", bg: "#{{palette.blue.hex}}", modifiers: "Bold"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#{{palette.base.hex}}", bg: "#{{palette.green.hex}}", modifiers: "Bold"))),
                ])))
            ], align: Center
        )),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        ),

	"sidebar": Split(
	    direction: Vertical,
	    panes: [
	        
                (
                    size: "100%",
                    pane: Pane(AlbumArt)
                ),
		(size: "1", pane: Component("album")),
		(size: "1", pane: Component("artist_and_title")),
		(size: "1", pane: Component("elapsed")),
	    ]
	),

	"sidebar_no_lyrics": Split(
	   direction: Vertical,
	   panes: [
	   	(pane: Component("sidebar"), size: "100%"),
		(pane: Pane(Empty()), size: "3")
	   ]
	)

    },

cava: (
    bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
    inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],

    bar_width: 1,
    bar_spacing: 1,
    orientation: Horizontal,
    bar_color: Gradient({

            12: "#{{palette.teal.hex}}",
            25: "#{{palette.sky.hex}}",
            36: "#{{palette.sapphire.hex}}",
            50: "#{{palette.blue.hex}}",
            60: "#{{palette.mauve.hex}}",
            75: "#{{palette.pink.hex}}",
            84: "#{{palette.maroon.hex}}",
            100: "#{{palette.red.hex}}",    
    }),
  ),
)
)
